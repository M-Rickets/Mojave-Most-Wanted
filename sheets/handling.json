{
 "sheet": "handling",
 "about": "Bodycam-style weapon handling on foot.",
 "columns": {
  "type": "eWeaponType number (0 hand-to-hand, 1 one-hand melee, 2 two-hand melee, 3 pistol, 4 energy pistol, 5 rifle, 6 automatic rifle, 7 energy rifle, 8 two-hand handle (minigun, flamer), 9 launcher, 10 grenade, 11 mine, 12 lunchbox mine, 13 thrown)",
  "label": "what it is",
  "kickDeg": "how far one shot kicks the view up at refDamage (degrees, the peak); 0 = no recoil",
  "sideDeg": "the random sideways part of a kick (degrees, either way)",
  "keep": "share of the kick that stays (you pull the gun back down yourself); the rest springs back",
  "returnHz": "how fast the kick springs back (higher = snappier)",
  "refDamage": "damage x projectiles that gives kickDeg; stronger guns kick more (square root)",
  "refWeight": "weight that gives swayDeg and lagSec; heavier guns sway and lag more, kick a little less",
  "swayDeg": "breathing sway, standing still (degrees)",
  "lagSec": "how far the view trails the mouse (seconds)",
  "formId": "weapons rows: the weapon's form id in FalloutNV.esm (mod index 00)",
  "kickScale": "weapons rows: times the type's kick",
  "swayScale": "weapons rows: times the type's sway and lag",
  "feed": "how the gun is fed, for reloads: 'box' (a detachable magazine, closed bolt: a reload with rounds left keeps one in the chamber, +1, and the dropped magazine's rounds are lost), 'open' (a detachable magazine or belt fired from an open bolt: no +1, the dropped rounds are lost), 'fixed' (revolvers, tubes, break-actions, internal magazines, energy cells, launchers: reloads unchanged). Looped reloads (shell by shell) are always left alone.",
  "plugin": "weapons rows: the master file the form id is in (FalloutNV.esm when left out); DLC ids are the low 6 hex digits"
 },
